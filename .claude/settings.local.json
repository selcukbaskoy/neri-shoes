{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Supabase__execute_sql",
      "PowerShell(Start-Sleep -Seconds 3; try { $r = Invoke-WebRequest -Uri \"http://localhost:3000\" -UseBasicParsing -TimeoutSec 5; $r.StatusCode } catch { \"not ready: $_\" })",
      "PowerShell(cargo2)",
      "PowerShell(pip install *)",
      "PowerShell(headroom init *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\\\Users\\\\selcu\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/selcu/AppData/Roaming/Python/Python314/Scripts/headroom.EXE init hook ensure --profile init-nerisohes.com-6b5f9275 --marker headroom-init-claude",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/selcu/AppData/Roaming/Python/Python314/Scripts/headroom.EXE init hook ensure --profile init-nerisohes.com-6b5f9275 --marker headroom-init-claude",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: runs after Edit/Write/MultiEdit on UI files and surfaces findings as system reminders.",
  "enabledPlugins": {
    "headroom@headroom-marketplace": true
  }
}
